database -open waves -into waves.shm -default
probe -create -shm memory_tb.memory_inst.addr memory_tb.memory_inst.clk memory_tb.memory_inst.cs memory_tb.memory_inst.data_in memory_tb.memory_inst.data_out memory_tb.memory_inst.i memory_tb.memory_inst.mem memory_tb.memory_inst.re memory_tb.memory_inst.reset memory_tb.memory_inst.we
probe -create -shm memory_tb.memory_inst.mem
run
